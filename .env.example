# Required for the foundation. This URL matches compose.yaml's local PostgreSQL.
DATABASE_URL=postgresql+asyncpg://mimit:mimit@localhost:55439/mimit

# Local display/reminder timezone; stored instants and clocks always use UTC.
HOUSEHOLD_TIMEZONE=Europe/Warsaw

# Telegram runtime: uncomment and fill ALL five values to enable the webhook.
# With these omitted, /healthz and /readyz are enabled. Never commit real credentials.
# TELEGRAM_BOT_TOKEN=replace-with-bot-token
# TELEGRAM_WEBHOOK_SECRET=replace-with-webhook-secret
# PUBLIC_BASE_URL=https://mimit.example.com
# TELEGRAM_ALLOWED_USER_ID=123456789
# TELEGRAM_ALLOWED_CHAT_ID=123456789

# Private worker: daily offer checks; these settings bound local processing.
WORKER_POLL_SECONDS=1
WORKER_SHUTDOWN_GRACE_SECONDS=30
WORKER_PRICE_CONCURRENCY=2

# Deterministic price advice, with stock-only fallback when evidence is missing.
RECOMMENDATION_HISTORY_DAYS=30
RECOMMENDATION_DISCOUNT_FRACTION=0.10
RECOMMENDATION_MIN_PRIOR_OBSERVATIONS=3
RECOMMENDATION_PRICE_MAX_AGE_HOURS=48
