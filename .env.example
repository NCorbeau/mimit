# Required for the foundation. This URL matches compose.yaml's local PostgreSQL.
DATABASE_URL=postgresql+asyncpg://mimit:mimit@localhost:55439/mimit

# Local display/reminder timezone; stored instants and clocks always use UTC.
HOUSEHOLD_TIMEZONE=Europe/Warsaw

# Future Telegram runtime: uncomment and fill ALL five values before enabling it.
# The foundation currently exposes only /healthz; no webhook or bot is implemented.
# TELEGRAM_BOT_TOKEN=replace-with-bot-token
# TELEGRAM_WEBHOOK_SECRET=replace-with-webhook-secret
# PUBLIC_BASE_URL=https://mimit.example.com
# TELEGRAM_ALLOWED_USER_ID=123456789
# TELEGRAM_ALLOWED_CHAT_ID=123456789
